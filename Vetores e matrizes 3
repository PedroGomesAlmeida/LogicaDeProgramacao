algoritmo "Exercicio3"

var
   matriz: vetor[1..3, 1..3] de inteiro
   i, j, soma: inteiro

inicio
   soma <- 0

   para i de 1 ate 3 faca
      para j de 1 ate 3 faca
         escreva("Digite o valor da posição [", i, ",", j, "]: ")
         leia(matriz[i,j])
         soma <- soma + matriz[i,j]
      fimpara
   fimpara

   escreval("A soma de todos os elementos é: ", soma)

fimalgoritmo

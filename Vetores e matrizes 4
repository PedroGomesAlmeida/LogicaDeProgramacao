algoritmo "Exercicio4"

var
   matriz: vetor[1..4, 1..4] de inteiro
   i, j: inteiro

inicio
   matriz[1,1] <- 5
   matriz[1,2] <- 8
   matriz[1,3] <- 2
   matriz[1,4] <- 9

   matriz[2,1] <- 4
   matriz[2,2] <- 7
   matriz[2,3] <- 1
   matriz[2,4] <- 6

   matriz[3,1] <- 3
   matriz[3,2] <- 0
   matriz[3,3] <- 10
   matriz[3,4] <- 12

   matriz[4,1] <- 11
   matriz[4,2] <- 15
   matriz[4,3] <- 13
   matriz[4,4] <- 20

   escreval("Diagonal principal:")

   para i de 1 ate 4 faca
      para j de 1 ate 4 faca
         se i = j entao
            escreval(matriz[i,j])
         fimse
      fimpara
   fimpara

fimalgoritmo
